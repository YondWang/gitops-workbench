GITLAB_BASE_URL=https://www.chancee-shanghai.cn:9900
GITLAB_PROJECT=software_hmi_app/business
GITLAB_TOKEN=replace-with-a-gitlab-token
GITLAB_SSL_VERIFY=true
# Personal Access Tokens start with glpat- and expire. A glft- token is a feed
# token and cannot call the GitLab API. If GitLab returns 401 invalid_token, create
# a new glpat- token with the api scope, update GITLAB_TOKEN, and restart.

# For additional repositories, either reuse GITLAB_TOKEN or create another
# environment variable and set token_env to that name in the web UI.
# GITLAB_TOKEN_OTHER=replace-with-another-gitlab-token

# Optional server binding.
GITOPS_HOST=127.0.0.1
GITOPS_PORT=8765

# x86 仿真包/自动化测试。SIMOS_SIM_NOTIFY_CALLBACK_TOKEN 必须与 SimOS CI/CD
# 中的同名变量一致；回调请求使用 X-Sim-Test-Token 头。
GITOPS_SIM_PACKAGE_ENABLED=true
GITOPS_SIM_TEST_TIMEOUT_HOURS=24
GITOPS_SIM_TEST_REPORT_ROOT=/data/simos-ci/sim-test-reports
GITOPS_SIM_RESULT_URL=https://www.chancee-shanghai.cn:9910/api/sim-test-results
SIMOS_SIM_NOTIFY_CALLBACK_TOKEN=replace-with-shared-callback-token
# 与 CI 同构的 JSON 数组，用于 webapp 重发通知。
GITOPS_SIM_NOTIFY_TARGETS=[{"name":"cloud-platform","url":"https://cloud-platform.example/api/sim-tasks","token":"replace-with-token","enabled":true}]
# 可选：轮询兜底接口，{task_id} 为占位符。
SIMOS_TEST_PLATFORM_STATUS_URL=
GITOPS_SIM_STATUS_POLL_SECONDS=60
GITOPS_SIM_TEST_SSL_VERIFY=true
# 报告代传云盘，复用 SimOS CI 的 SSH 投递通道。
GITOPS_CLOUD_UPLOAD_HOST=192.168.110.17
GITOPS_CLOUD_UPLOAD_USER=simos-ci-uploader
GITOPS_CLOUD_UPLOAD_PORT=22
GITOPS_CLOUD_UPLOAD_BASE=/data/simos-ci/incoming
GITOPS_CLOUD_UPLOAD_SSH_KEY=replace-with-private-key-or-file-path
GITOPS_SIM_SERVER_PUBLISHER=/usr/local/bin/simos-ci-publish-sim
GITOPS_CLOUD_CATEGORY=车机/CI自动构建

# Default login passwords are admin/admin123 and user/user123.
# Override them before exposing the service beyond localhost.
GITOPS_ADMIN_PASSWORD=change-admin-password
GITOPS_USER_PASSWORD=change-user-password
# Generate with: openssl rand -base64 48
GITOPS_SESSION_SECRET=replace-with-a-long-random-string

# Full release tasks automatically request the merge of their version-info MR,
# then resume tagging only after GitLab reports that MR as merged. The token
# configured for the simos repository must have API scope and merge permission.
# It must also be allowed to create pipelines after a Tag is created.
# The recovery worker checks pending full-release MR merges at this interval.
GITOPS_RELEASE_RUN_POLL_SECONDS=10

# Required by the Workbench service to sign Feature package contexts. Set the
# identical value as a masked, protected CI/CD variable in gitops-control.
GITOPS_FEATURE_CONTEXT_HMAC_KEY=replace-with-a-long-random-feature-context-key

# Feature CI protected variables, configured in GitLab (not in this file):
# GITOPS_FEATURE_CLOUD_CATEGORIES=车机/CI自动构建,车机/Feature测试包
# GITOPS_FEATURE_BUILD_IMAGE=<protected maintained Feature build image>
# GITOPS_FEATURE_SIMOS_PROJECT_ID=<OS/simos numeric project id>
# GITOPS_FEATURE_NEXTCLOUD_URL=https://nextcloud.example
# GITOPS_FEATURE_NEXTCLOUD_USER=<restricted feature publisher account>
# GITOPS_FEATURE_NEXTCLOUD_PASSWORD=<masked restricted password>
# The Feature build runner must be a non-privileged container executor with no
# Docker socket, host-sensitive mounts, OTA credentials, or publish variables.

# OTA cloud credentials do not belong in this file or in Workbench data.
# Set SIMOS_OTA_APP_KEY and SIMOS_OTA_SECRET_KEY only as masked, protected
# GitLab CI/CD Variables on the SimOS project. Formal Tag pipelines must match
# a GitLab Protected Tag rule for those values to be injected.

# Local-only end-to-end simulation. Set GITOPS_MODE=simulation and use
# docker-compose.simulation.yml; this never calls GitLab or triggers CI.
# GITOPS_MODE=simulation
# GITOPS_DATA_DIR=./data-simulation
# GITOPS_SIMULATION_STATE=./data-simulation/simulation-state.json

# Optional advanced user config. Each account may carry role + password_hash
# (or plaintext password, hashed in memory). Generate a hash with:
#   echo 'your-secret' | python3 webapp/manage_auth.py hash-password
# GITOPS_USERS_JSON={"zhangsan":{"role":"user","password_hash":"pbkdf2_sha256$..."},"workbench-admin":{"role":"admin","password_hash":"pbkdf2_sha256$..."}}
#
# After login, an admin can also add/manage accounts from the UI (账号管理),
# which are persisted to the data directory. Accounts created in the UI always
# require a password (no default password).

# Optional: when simos tag pipelines run on a cloud runner, read resident outputs from GitLab job artifacts.
SIMOS_CI_ARTIFACT_JOB_NAMES=resident,resident-package,package,build
SIMOS_CI_ARTIFACT_FILE=resident.tar.gz
SIMOS_CI_BUILD_INFO_FILE=build-info.json
