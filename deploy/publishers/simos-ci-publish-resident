#!/usr/bin/env bash
set -Eeuo pipefail

ARTIFACT_ROOT="${SIMOS_PUBLISH_ARTIFACT_ROOT:-/data/simos-ci/artifacts}"
NEXTCLOUD_VERSIONS_ROOT="${SIMOS_PUBLISH_NEXTCLOUD_VERSIONS_ROOT:-/home/data/nextcloud/app/data/__groupfolders/1/files/Versions}"
NEXTCLOUD_PUBLIC_ROOT="${SIMOS_PUBLISH_NEXTCLOUD_PUBLIC_ROOT:-/public/Versions}"
NEXTCLOUD_CONTAINER="${SIMOS_PUBLISH_NEXTCLOUD_CONTAINER:-envs-app-1}"
NEXTCLOUD_GROUPFOLDER_ID="${SIMOS_PUBLISH_NEXTCLOUD_GROUPFOLDER_ID:-1}"
SKIP_OCC="${SIMOS_PUBLISH_SKIP_OCC:-false}"
PUBLISHER_CAPABILITY="config-matrix-runtime-switchable-isolated-layout-v2"

usage() {
  cat <<'USAGE'
usage: simos-ci-publish-resident --incoming DIR --tag TAG --version VERSION --date YYYY-MM-DD --category CATEGORY [options]

Options:
  --capability config-matrix-runtime-switchable-isolated-layout-v2
  --deb-only
  --project PROJECT
  --commit-sha SHA
  --pipeline-id ID
  --job-id ID
  --pipeline-url URL
  --feature-build-id BUILD_ID
USAGE
}

die() {
  echo "[publish] ERROR: $*" >&2
  exit 2
}

if [[ "${1:-}" == "--capability" ]]; then
  [[ ( "${2:-}" == "$PUBLISHER_CAPABILITY" || "${2:-}" == "feature-package-v1" ) && "$#" -eq 2 ]] || die "unsupported publisher capability: ${2:-}"
  printf '%s\n' "$2"
  exit 0
fi

safe_ref() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

safe_version() {
  [[ "$1" =~ ^[VvFfTt]?[0-9]+([.][0-9]+)+$ ]]
}

# Feature packages use a timestamp plus a human-readable suffix as their
# immutable build/version identifier (for example,
# T20260909133734_r3).  This is intentionally kept separate from the normal
# release-version grammar above: ordinary publications must continue to use
# the dot-separated numeric version format.
safe_feature_build_id() {
  [[ "$1" =~ ^T[0-9]{14}_[A-Za-z0-9.-]+$ ]]
}

safe_date() {
  [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]
}

safe_category() {
  local value="$1"
  [[ -n "$value" && "$value" != /* && "$value" != *".."* && "$value" != *"//"* ]]
}

safe_dir_name() {
  local value="$1"
  [[ -n "$value" && "$value" != */* && "$value" != *".."* ]]
}

scan_nextcloud() {
  local cloud_relative="$1"
  if [[ "$SKIP_OCC" != "true" ]]; then
    docker exec --user www-data "$NEXTCLOUD_CONTAINER" php occ groupfolders:scan "$NEXTCLOUD_GROUPFOLDER_ID" --path="/Versions/${cloud_relative}"
  fi
}

fix_permissions() {
  local artifact_dir="$1"
  local version_target="$2"
  if [[ "$(id -u)" -eq 0 ]]; then
    chown -R gitlab-runner:docker "$artifact_dir" 2>/dev/null || true
    chown -R www-data:www-data "$version_target" 2>/dev/null || true
  fi
  # cp -a from mktemp preserves mode 0700 on staging directories.  That makes
  # freshly published Groupfolder releases appear locked to normal users.
  find "$version_target" -type d -exec chmod 0755 {} + 2>/dev/null || true
  find "$version_target" -type f -exec chmod 0644 {} + 2>/dev/null || true
}

remove_resident_outputs() {
  local target_dir="$1"
  local path
  for path in \
    "$target_dir/resident.tar.gz" \
    "$target_dir/resident.md5" \
    "$target_dir/simos.config" \
    "$target_dir/deploy.sh" \
    "$target_dir/remote_run.sh" \
    "$target_dir/checksum.md5" \
    "$target_dir/checksums.txt" \
    "$target_dir/manifest.json" \
    "$target_dir/build-info.json"; do
    rm -rf "$path"
  done

  for path in "$target_dir"/*; do
    [[ -d "$path" && -f "$path/resident.tar.gz" ]] || continue
    rm -rf "$path"
  done
}

write_release_manifest() {
  local lock_dir="${ARTIFACT_ROOT}/.locks"
  local lock_file="${lock_dir}/${TAG}.lock"

  mkdir -p "$lock_dir" "$ARTIFACT_DIR" "$CLOUD_TARGET"
  (
    flock -x 9
    ROOT_CLOUD_DIR="$CLOUD_DIR" \
    ROOT_ARTIFACT_DIR="$ARTIFACT_DIR" \
    ROOT_CLOUD_TARGET="$CLOUD_TARGET" \
    TAG="$TAG" VERSION="$VERSION" DATE_VALUE="$DATE_VALUE" \
    PROJECT="$PROJECT" COMMIT_SHA="$COMMIT_SHA" PIPELINE_ID="$PIPELINE_ID" \
    python3 - <<'PY'
import json
import os
from pathlib import Path

cloud_target = Path(os.environ["ROOT_CLOUD_TARGET"])
artifact_dir = Path(os.environ["ROOT_ARTIFACT_DIR"])

def publication(directory, manifest_name):
    manifest = cloud_target / directory / manifest_name
    if not manifest.is_file():
        return {}
    data = json.loads(manifest.read_text(encoding="utf-8"))
    return {
        "path": directory,
        "manifest": f"{directory}/{manifest_name}",
        "published_at": data.get("published_at", data.get("built_at", "")),
    }

payload = {
    "tag": os.environ["TAG"],
    "version": os.environ["VERSION"],
    "date": os.environ["DATE_VALUE"],
    "source_project": os.environ["PROJECT"],
    "commit_sha": os.environ.get("COMMIT_SHA", ""),
    "pipeline_id": os.environ.get("PIPELINE_ID", ""),
    "cloud_dir": os.environ["ROOT_CLOUD_DIR"],
    "resident": publication("resident", "manifest.json"),
    "deb": publication("deb", "deb-package-manifest.json"),
}
text = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
(cloud_target / "release-manifest.json").write_text(text, encoding="utf-8")
(artifact_dir / "release-manifest.json").write_text(text, encoding="utf-8")
PY
  ) 9>"$lock_file"
}

INCOMING=""
TAG=""
VERSION=""
DATE_VALUE=""
CATEGORY=""
PROJECT="OS/simos"
COMMIT_SHA=""
PIPELINE_ID=""
JOB_ID=""
PIPELINE_URL=""
FEATURE_BUILD_ID=""
MODE="resident"

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --deb-only) MODE="deb"; shift ;;
    --incoming) INCOMING="${2:-}"; shift 2 ;;
    --tag) TAG="${2:-}"; shift 2 ;;
    --version) VERSION="${2:-}"; shift 2 ;;
    --date) DATE_VALUE="${2:-}"; shift 2 ;;
    --category) CATEGORY="${2:-}"; shift 2 ;;
    --project) PROJECT="${2:-}"; shift 2 ;;
    --commit-sha) COMMIT_SHA="${2:-}"; shift 2 ;;
    --pipeline-id) PIPELINE_ID="${2:-}"; shift 2 ;;
    --job-id) JOB_ID="${2:-}"; shift 2 ;;
    --pipeline-url) PIPELINE_URL="${2:-}"; shift 2 ;;
    --feature-build-id) FEATURE_BUILD_ID="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -d "$INCOMING" ]] || die "incoming directory not found: $INCOMING"
if [[ -n "$FEATURE_BUILD_ID" ]]; then
  safe_feature_build_id "$FEATURE_BUILD_ID" || die "invalid feature build id: $FEATURE_BUILD_ID"
  [[ "$TAG" == "$FEATURE_BUILD_ID" && "$VERSION" == "$FEATURE_BUILD_ID" ]] || die "feature build id must match tag and version"
else
  safe_version "$VERSION" || die "invalid version: $VERSION"
fi
safe_ref "$TAG" || die "invalid tag: $TAG"
safe_date "$DATE_VALUE" || die "invalid date: $DATE_VALUE"
safe_category "$CATEGORY" || die "invalid category: $CATEGORY"

PUBLISH_ROOT_NAME="${DATE_VALUE}_${VERSION}"
CLOUD_RELATIVE="${PUBLISH_ROOT_NAME}/${CATEGORY}"
CLOUD_DIR="${NEXTCLOUD_PUBLIC_ROOT}/${CLOUD_RELATIVE}"
ARTIFACT_DIR="$ARTIFACT_ROOT/$TAG"
VERSION_TARGET="$NEXTCLOUD_VERSIONS_ROOT/$PUBLISH_ROOT_NAME"
CLOUD_TARGET="$NEXTCLOUD_VERSIONS_ROOT/$CLOUD_RELATIVE"

mkdir -p "$ARTIFACT_ROOT" "$(dirname "$CLOUD_TARGET")"

publish_resident() {
  local package_dir="$INCOMING/resident-packages"
  local artifact_target="${ARTIFACT_DIR}/resident"
  local cloud_target="${CLOUD_TARGET}/resident"
  local published_cloud_dir="${CLOUD_DIR}/resident"
  [[ -d "$package_dir" ]] || die "resident-packages not found: $package_dir"

  local variant_dirs=()
  local dir
  while IFS= read -r dir; do
    variant_dirs+=("$dir")
  done < <(find "$package_dir" -mindepth 1 -maxdepth 1 -type d | sort)
  if [[ "${#variant_dirs[@]}" -eq 0 && -f "$package_dir/resident.tar.gz" ]]; then
    variant_dirs=("$package_dir")
  fi
  [[ "${#variant_dirs[@]}" -gt 0 ]] || die "missing resident.tar.gz"
  for dir in "${variant_dirs[@]}"; do
    [[ -f "$dir/resident.tar.gz" ]] || die "missing $(basename "$dir")/resident.tar.gz"
    for sidecar in simos.config deploy.sh remote_run.sh checksum.md5; do
      [[ -f "$dir/${sidecar}" ]] || die "missing $(basename "$dir")/${sidecar}"
    done
  done

  local stage
  stage="$(mktemp -d "$ARTIFACT_ROOT/.resident-stage-${TAG}-${JOB_ID:-manual}.XXXXXX")"
  trap 'rm -rf "$stage"' RETURN
  local checksums_file="$stage/checksums.txt"
  : > "$checksums_file"
  local variant_label
  local dst_dir
  for dir in "${variant_dirs[@]}"; do
    variant_label=""
    if [[ "$dir" != "$package_dir" ]]; then
      variant_label="$(basename "$dir")"
      dst_dir="$stage/$variant_label"
    else
      dst_dir="$stage"
    fi
    mkdir -p "$dst_dir"
    cp -f "$dir/resident.tar.gz" "$dst_dir/resident.tar.gz"
    for sidecar in simos.config deploy.sh remote_run.sh checksum.md5 resident.md5 build-info.json; do
      [[ -f "$dir/${sidecar}" ]] || continue
      cp -f "$dir/${sidecar}" "$dst_dir/${sidecar}"
    done
    if [[ -n "$variant_label" ]]; then
      printf '%s  %s\n' "$(sha256sum "$dir/resident.tar.gz" | awk '{print $1}')" "${variant_label}/resident.tar.gz" >> "$checksums_file"
    else
      printf '%s  %s\n' "$(sha256sum "$dir/resident.tar.gz" | awk '{print $1}')" "resident.tar.gz" >> "$checksums_file"
    fi
  done
  local published_at
  published_at="$(date -Iseconds)"
  export TAG VERSION DATE_VALUE PROJECT COMMIT_SHA PIPELINE_ID JOB_ID PIPELINE_URL PUBLISHED_AT="$published_at" INCOMING STAGE="$stage"

  CLOUD_DIR="$published_cloud_dir" python3 - <<'PY' > "$stage/manifest.json"
import hashlib
import json
import os
from pathlib import Path

def config_meta():
    incoming = Path(os.environ["INCOMING"])
    for rel in ("build-info.json", "package-registry-result.json"):
        path = incoming / rel
        if path.is_file():
            data = json.loads(path.read_text(encoding="utf-8"))
            return {
                "config_ref": data.get("config_ref", ""),
                "config_commit": data.get("config_commit", ""),
            }
    return {"config_ref": "", "config_commit": ""}

stage = Path(os.environ["STAGE"])
variants = []
variant_dirs = sorted(path for path in stage.iterdir() if path.is_dir() and (path / "resident.tar.gz").is_file())
if variant_dirs:
    for variant_dir in variant_dirs:
        package = variant_dir / "resident.tar.gz"
        data = package.read_bytes()
        info_path = variant_dir / "build-info.json"
        info = json.loads(info_path.read_text(encoding="utf-8")) if info_path.is_file() else {}
        variants.append({
            "label": info.get("label", variant_dir.name),
            "config_ref": info.get("config_ref", ""),
            "config_commit": info.get("config_commit", ""),
            "path": f"{variant_dir.name}/resident.tar.gz",
            "md5": hashlib.md5(data).hexdigest(),
            "sha256": hashlib.sha256(data).hexdigest(),
        })
elif (stage / "resident.tar.gz").is_file():
    package = stage / "resident.tar.gz"
    data = package.read_bytes()
    variants.append({
        "label": "",
        "config_ref": config_meta().get("config_ref", ""),
        "config_commit": config_meta().get("config_commit", ""),
        "path": "resident.tar.gz",
        "md5": hashlib.md5(data).hexdigest(),
        "sha256": hashlib.sha256(data).hexdigest(),
    })

payload = {
    "tag": os.environ["TAG"],
    "version": os.environ["VERSION"],
    "date": os.environ["DATE_VALUE"],
    "source_project": os.environ["PROJECT"],
    "commit_sha": os.environ.get("COMMIT_SHA", ""),
    "pipeline_id": os.environ.get("PIPELINE_ID", ""),
    "job_id": os.environ.get("JOB_ID", ""),
    "pipeline_url": os.environ.get("PIPELINE_URL", ""),
    "cloud_dir": os.environ["CLOUD_DIR"],
    **config_meta(),
    "artifact_model": "config_matrix_runtime_switchable" if len(variants) > 1 else "single_resident_runtime_switchable",
    "runtime_profiles": ["Vd", "Vi", "Vo", "Vs"],
    "config_variants": variants,
    "package": variants[0] if variants else {},
    "published_at": os.environ["PUBLISHED_AT"],
}
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY

  CLOUD_DIR="$published_cloud_dir" python3 - <<'PY' > "$stage/build-info.json"
import hashlib
import json
import os
from pathlib import Path

def config_meta():
    incoming = Path(os.environ["INCOMING"])
    for rel in ("build-info.json", "package-registry-result.json"):
        path = incoming / rel
        if path.is_file():
            data = json.loads(path.read_text(encoding="utf-8"))
            return {
                "config_ref": data.get("config_ref", ""),
                "config_commit": data.get("config_commit", ""),
            }
    return {"config_ref": "", "config_commit": ""}

stage = Path(os.environ["STAGE"])
variant_dirs = sorted(path for path in stage.iterdir() if path.is_dir() and (path / "resident.tar.gz").is_file())
variants = []
for variant_dir in variant_dirs:
    data = (variant_dir / "resident.tar.gz").read_bytes()
    info_path = variant_dir / "build-info.json"
    info = json.loads(info_path.read_text(encoding="utf-8")) if info_path.is_file() else {}
    variants.append({
        "label": info.get("label", variant_dir.name),
        "config_ref": info.get("config_ref", ""),
        "config_commit": info.get("config_commit", ""),
        "artifact_path": f"{variant_dir.name}/resident.tar.gz",
        "sha256": hashlib.sha256(data).hexdigest(),
        "md5": hashlib.md5(data).hexdigest(),
    })
if not variants and (stage / "resident.tar.gz").is_file():
    data = (stage / "resident.tar.gz").read_bytes()
    variants.append({
        "label": "",
        "config_ref": config_meta().get("config_ref", ""),
        "config_commit": config_meta().get("config_commit", ""),
        "artifact_path": "resident.tar.gz",
        "sha256": hashlib.sha256(data).hexdigest(),
        "md5": hashlib.md5(data).hexdigest(),
    })

payload = {
    "status": "success",
    "tag": os.environ["TAG"],
    "version": os.environ["VERSION"],
    "message": "resident package published to Nextcloud",
    "artifact_source": "cloud",
    "artifact_path": os.environ["CLOUD_DIR"],
    "cloud_dir": os.environ["CLOUD_DIR"],
    "artifact_model": "config_matrix_runtime_switchable" if len(variants) > 1 else "single_resident_runtime_switchable",
    "runtime_profiles": ["Vd", "Vi", "Vo", "Vs"],
    "config_variants": variants,
    "sha256": variants[0]["sha256"] if variants else "",
    "md5": variants[0]["md5"] if variants else "",
    "built_at": os.environ["PUBLISHED_AT"],
    "pipeline_id": os.environ.get("PIPELINE_ID", ""),
    "pipeline_url": os.environ.get("PIPELINE_URL", ""),
    "job_id": os.environ.get("JOB_ID", ""),
    "commit_sha": os.environ.get("COMMIT_SHA", ""),
    **config_meta(),
}
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY

  mkdir -p "$artifact_target" "$cloud_target"
  remove_resident_outputs "$artifact_target"
  remove_resident_outputs "$cloud_target"
  cp -a "$stage/." "$artifact_target/"
  cp -a "$stage/." "$cloud_target/"
  write_release_manifest
  fix_permissions "$artifact_target" "$VERSION_TARGET"
  scan_nextcloud "${CLOUD_RELATIVE}/resident"
  echo "[publish] resident artifact_dir=$artifact_target"
  echo "[publish] resident cloud_dir=$published_cloud_dir"
}

publish_deb() {
  local package_dir="$INCOMING/deb-packages"
  local artifact_target="${ARTIFACT_DIR}/deb"
  local cloud_target="${CLOUD_TARGET}/deb"
  local published_cloud_dir="${CLOUD_DIR}/deb"
  [[ -d "$package_dir" ]] || die "deb-packages not found: $package_dir"
  if ! find "$package_dir" -type f | grep -q .; then
    die "deb-packages is empty"
  fi

  local stage
  stage="$(mktemp -d "$ARTIFACT_ROOT/.deb-stage-${TAG}-${JOB_ID:-manual}.XXXXXX")"
  trap 'rm -rf "$stage"' RETURN
  mkdir -p "$stage"

  local file_path
  while IFS= read -r file_path; do
    [[ -f "$file_path" ]] || continue
    rel_path="${file_path#"$package_dir/"}"
    mkdir -p "$(dirname "$stage/$rel_path")"
    cp -f "$file_path" "$stage/$rel_path"
  done < <(find "$package_dir" -type f | sort)

  local published_at
  published_at="$(date -Iseconds)"
  export TAG VERSION DATE_VALUE PROJECT COMMIT_SHA PIPELINE_ID JOB_ID PIPELINE_URL PUBLISHED_AT="$published_at" DEB_STAGE="$stage" INCOMING
  CLOUD_DIR="$published_cloud_dir" python3 - <<'PY' > "$stage/deb-package-manifest.json"
import hashlib
import json
import os
from pathlib import Path

def config_meta():
    incoming = Path(os.environ["INCOMING"])
    for rel in ("deb-packages/deb-package-registry-result.json", "deb-package-registry-result.json"):
        path = incoming / rel
        if path.is_file():
            data = json.loads(path.read_text(encoding="utf-8"))
            return {
                "config_ref": data.get("config_ref", ""),
                "config_commit": data.get("config_commit", ""),
            }
    return {"config_ref": "", "config_commit": ""}

deb_stage = Path(os.environ["DEB_STAGE"])
files = []
variants = {}
for path in sorted(deb_stage.rglob("*")):
    if not path.is_file():
        continue
    rel = path.relative_to(deb_stage)
    data = path.read_bytes()
    item = {
        "file": path.name,
        "path": "deb/" + str(rel),
        "size": len(data),
        "md5": hashlib.md5(data).hexdigest(),
        "sha256": hashlib.sha256(data).hexdigest(),
    }
    parts = rel.parts
    if len(parts) > 1:
        variants.setdefault(parts[0], []).append(item)
    files.append(item)
config_variants = []
incoming = Path(os.environ["INCOMING"])
registry_files = sorted(incoming.glob("*deb-package-registry-result.json"))
seen_labels = set()
for registry in registry_files:
    registry_data = json.loads(registry.read_text(encoding="utf-8"))
    for variant in registry_data.get("config_variants", []):
        label = str(variant.get("label") or "")
        if label in seen_labels:
            continue
        seen_labels.add(label)
        config_variants.append({
            "label": label,
            "config_ref": variant.get("config_ref", ""),
            "config_commit": variant.get("config_commit", ""),
            "files": variants.get(label, []),
        })
payload = {
    "tag": os.environ["TAG"],
    "version": os.environ["VERSION"],
    "date": os.environ["DATE_VALUE"],
    "source_project": os.environ["PROJECT"],
    "commit_sha": os.environ.get("COMMIT_SHA", ""),
    "pipeline_id": os.environ.get("PIPELINE_ID", ""),
    "job_id": os.environ.get("JOB_ID", ""),
    "pipeline_url": os.environ.get("PIPELINE_URL", ""),
    "cloud_dir": os.environ["CLOUD_DIR"],
    **config_meta(),
    "artifact_model": "config_matrix" if config_variants else "single_config",
    "config_variants": config_variants,
    "files": files,
    "published_at": os.environ["PUBLISHED_AT"],
}
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY
  python3 - <<'PY' > "$stage/deb-checksums.txt"
import hashlib
import os
from pathlib import Path

for path in sorted(Path(os.environ["DEB_STAGE"]).rglob("*")):
    if path.is_file():
        rel = path.relative_to(Path(os.environ["DEB_STAGE"]))
        print("{}  deb/{}".format(hashlib.sha256(path.read_bytes()).hexdigest(), rel))
PY

  rm -rf "$artifact_target" "$cloud_target"
  mkdir -p "$artifact_target" "$cloud_target"
  cp -a "$stage/." "$artifact_target/"
  cp -a "$stage/." "$cloud_target/"
  write_release_manifest
  fix_permissions "$artifact_target" "$VERSION_TARGET"
  scan_nextcloud "${CLOUD_RELATIVE}/deb"
  echo "[publish] deb artifact_dir=$artifact_target"
  echo "[publish] deb cloud_dir=$published_cloud_dir"
}

case "$MODE" in
  resident) publish_resident ;;
  deb) publish_deb ;;
  *) die "invalid mode: $MODE" ;;
esac
